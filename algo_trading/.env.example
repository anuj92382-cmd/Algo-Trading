# ============================================================
# Zerodha Kite Connect API Credentials
# Kite Developer Console (kite.trade) se copy karo
# ============================================================
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_USER_ID=your_zerodha_user_id

# Request Token (har din login ke baad update hoga)
KITE_REQUEST_TOKEN=

# Access Token (auto-generate hoga)
KITE_ACCESS_TOKEN=

# ============================================================
# Trading Settings
# ============================================================
# "PAPER" = Simulated trading (safe)
# "LIVE"  = Real money trading
TRADING_MODE=PAPER

# Trading capital (₹)
TOTAL_CAPITAL=100000

# Max risk per trade (% of capital)
MAX_RISK_PER_TRADE=1.0

# Max daily loss limit (% of capital)
MAX_DAILY_LOSS=3.0

# ============================================================
# Notification (Optional - Telegram Alerts)
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
